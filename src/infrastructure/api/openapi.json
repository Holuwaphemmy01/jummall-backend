{
  "openapi": "3.0.3",
  "info": {
    "title": "Jummall API",
    "version": "1.0.0",
    "description": "API documentation for authentication, buyer onboarding, seller operations, and admin management."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Login any user role",
        "description": "Authenticates a buyer, seller, or admin and returns a JWT access token. If the credentials are valid but the account is still not verified, the request is rejected and a verification code is re-sent to the user's email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "403": {
            "description": "Account is not verified"
          },
          "429": {
            "description": "Too many login attempts"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Initiate password reset",
        "description": "Starts the forgot-password flow. This endpoint intentionally returns a generic success response even when the email does not exist, so frontend should not expect account-existence feedback here.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset initiation completed"
          },
          "400": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Too many password reset requests"
          }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["auth"],
        "summary": "Verify a user's email with a code",
        "description": "Confirms the verification code sent to the user's email and updates the user account status to `verified`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired verification code"
          },
          "404": {
            "description": "Verification request not found"
          },
          "409": {
            "description": "Account already verified"
          }
        }
      }
    },
    "/auth/resend-verification-email": {
      "post": {
        "tags": ["auth"],
        "summary": "Resend a verification email",
        "description": "Re-issues an email verification code when the resend cooldown has passed. Any previously active verification code is invalidated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification email resent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendVerificationEmailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "404": {
            "description": "Verification request not found"
          },
          "409": {
            "description": "Account already verified"
          },
          "429": {
            "description": "Resend requested too soon"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Reset password with a code",
        "description": "Completes the password reset flow using the reset code sent by email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successful"
          },
          "400": {
            "description": "Invalid code or validation failed"
          },
          "429": {
            "description": "Too many reset attempts"
          }
        }
      }
    },
    "/admin/product-categories": {
      "post": {
        "tags": ["admin-product-categories"],
        "summary": "Create product category",
        "description": "Creates a reusable product category for the marketplace. Sellers later fetch and reference these categories when creating products.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product category created successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "409": {
            "description": "Product category name already exists"
          }
        }
      },
      "get": {
        "tags": ["admin-product-categories"],
        "summary": "List product categories",
        "description": "Returns all product categories currently available in the admin-managed catalog.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Product categories fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/admin/product-brands": {
      "post": {
        "tags": ["admin-product-brands"],
        "summary": "Create product brand",
        "description": "Creates a reusable product brand. Sellers can only reference brands created by admins.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductBrandRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product brand created successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "409": {
            "description": "Product brand name already exists"
          }
        }
      },
      "get": {
        "tags": ["admin-product-brands"],
        "summary": "List product brands",
        "description": "Returns all admin-managed product brands available for seller product creation.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Product brands fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/admin/product-brands/{brandId}": {
      "get": {
        "tags": ["admin-product-brands"],
        "summary": "Get product brand",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "brandId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product brand fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product brand not found"
          }
        }
      },
      "patch": {
        "tags": ["admin-product-brands"],
        "summary": "Update product brand",
        "description": "Updates the name or description of an admin-managed product brand.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "brandId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductBrandRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product brand updated successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product brand not found"
          },
          "409": {
            "description": "Product brand name already exists"
          }
        }
      }
    },
    "/admin/product-categories/{categoryId}": {
      "get": {
        "tags": ["admin-product-categories"],
        "summary": "Get product category",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "categoryId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product category fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product category not found"
          }
        }
      },
      "patch": {
        "tags": ["admin-product-categories"],
        "summary": "Update product category",
        "description": "Updates category metadata or deduction percentage used across the marketplace.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "categoryId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product category updated successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product category not found"
          },
          "409": {
            "description": "Product category name already exists"
          }
        }
      }
    },
    "/admin/products/pending-review": {
      "get": {
        "tags": ["admin-product-review"],
        "summary": "List products pending review",
        "description": "Returns all seller-submitted products that are still waiting for admin moderation.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Products pending review fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/admin/products/pending-review/{productId}": {
      "get": {
        "tags": ["admin-product-review"],
        "summary": "Get a product pending review",
        "description": "Returns the full product details for one pending-review product, including category, brand reference, and uploaded images.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product pending review fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product pending review not found"
          }
        }
      }
    },
    "/admin/products/{productId}/approve": {
      "post": {
        "tags": ["admin-product-review"],
        "summary": "Approve a product pending review",
        "description": "Marks a product as `approved`. Approved products are the ones intended to become visible to buyers in later buyer-facing catalog endpoints.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveProductPendingReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product approved successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product pending review not found"
          },
          "409": {
            "description": "Product cannot be approved in the current state"
          }
        }
      }
    },
    "/admin/products/{productId}/reject": {
      "post": {
        "tags": ["admin-product-review"],
        "summary": "Reject a product pending review",
        "description": "Marks a product as `rejected`. Frontend should expect the rejection reason to come back through `review_note`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectProductPendingReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product rejected successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Product pending review not found"
          },
          "409": {
            "description": "Product cannot be rejected in the current state"
          }
        }
      }
    },
    "/admin/kyc": {
      "get": {
        "tags": ["admin-kyc"],
        "summary": "List completed seller KYC submissions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Completed seller KYC submissions fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/admin/kyc/{kycId}": {
      "get": {
        "tags": ["admin-kyc"],
        "summary": "Get a completed seller KYC submission",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "kycId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Seller KYC submission fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Seller KYC submission not found"
          }
        }
      }
    },
    "/admin/kyc/{kycId}/approve": {
      "post": {
        "tags": ["admin-kyc"],
        "summary": "Approve a seller KYC submission",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "kycId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveSellerKycRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seller KYC approved successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Seller KYC submission not found"
          },
          "409": {
            "description": "Seller KYC cannot be approved in the current state"
          }
        }
      }
    },
    "/buyers/register": {
      "post": {
        "tags": ["buyer-account"],
        "summary": "Register a buyer account",
        "description": "Creates a buyer account in `not_verified` state and triggers email verification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuyerRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Buyer registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuyerRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Buyer credentials already exist"
          }
        }
      }
    },
    "/sellers/register": {
      "post": {
        "tags": ["seller-account"],
        "summary": "Register a seller account",
        "description": "Creates a seller account in `not_verified` state, initializes seller KYC as `not_started`, and triggers email verification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SellerRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Seller registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Seller credentials already exist"
          }
        }
      }
    },
    "/sellers/create-product": {
      "post": {
        "tags": ["seller-catalog"],
        "summary": "Upload a product as a verified seller",
        "description": "Creates a seller product in `pending_review` state. This endpoint requires a seller token, a verified seller account, and approved seller KYC. `brand_id` is optional, `category_id` is required, and `sku` can be omitted because the backend can generate it.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product uploaded successfully and is pending review"
          },
          "400": {
            "description": "Validation failed or product data is invalid"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Seller access required"
          },
          "404": {
            "description": "Product category not found"
          },
          "409": {
            "description": "Seller account cannot upload products in the current state"
          }
        }
      }
    },
    "/sellers/product-brands": {
      "get": {
        "tags": ["seller-catalog"],
        "summary": "List available product brands for sellers",
        "description": "Returns the admin-managed brand list that sellers should use when populating optional `brand_id` in product creation.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Product brands fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Seller access required"
          }
        }
      }
    },
    "/sellers/product-categories": {
      "get": {
        "tags": ["seller-catalog"],
        "summary": "List available product categories for sellers",
        "description": "Returns the admin-managed category list that sellers should use when populating required `category_id` in product creation.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Product categories fetched successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Seller access required"
          }
        }
      }
    },
    "/sellers/kyc": {
      "put": {
        "tags": ["seller-kyc"],
        "summary": "Save seller KYC draft",
        "description": "Saves or updates a seller KYC draft. Required fields differ depending on `account_type`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSellerKycDraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seller KYC draft saved successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "KYC cannot be updated in the current state"
          }
        }
      }
    },
    "/sellers/kyc/documents": {
      "post": {
        "tags": ["seller-kyc"],
        "summary": "Upload a seller KYC document",
        "description": "Uploads one seller KYC document at a time. This endpoint is designed to be simpler for web and mobile clients than sending all documents in one large request.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadSellerKycDocumentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Seller KYC document uploaded successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Document cannot be updated in the current KYC state"
          }
        }
      }
    },
    "/sellers/kyc/submit": {
      "post": {
        "tags": ["seller-kyc"],
        "summary": "Submit seller KYC for review",
        "description": "Performs final validation on the seller KYC draft and uploaded documents, then moves the KYC record to `submitted`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitSellerKycRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seller KYC submitted successfully"
          },
          "400": {
            "description": "KYC submission is incomplete"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "KYC cannot be submitted in the current state"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Operational endpoints used for uptime and health monitoring."
    },
    {
      "name": "auth",
      "description": "Authentication, email verification, and password reset endpoints shared across all roles."
    },
    {
      "name": "buyer-account",
      "description": "Buyer onboarding endpoints."
    },
    {
      "name": "seller-account",
      "description": "Seller account registration and account bootstrap endpoints."
    },
    {
      "name": "seller-catalog",
      "description": "Seller-facing catalog endpoints for reading admin-managed metadata and creating products."
    },
    {
      "name": "seller-kyc",
      "description": "Seller KYC draft, document upload, and submission endpoints."
    },
    {
      "name": "admin-product-brands",
      "description": "Admin-managed product brand catalog endpoints."
    },
    {
      "name": "admin-product-categories",
      "description": "Admin-managed product category catalog endpoints, including deduction percentage configuration."
    },
    {
      "name": "admin-product-review",
      "description": "Admin moderation endpoints for seller-submitted products."
    },
    {
      "name": "admin-kyc",
      "description": "Admin review and approval endpoints for seller KYC submissions."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Login successful."
          },
          "data": {
            "type": "object",
            "properties": {
              "access_token": {
                "type": "string"
              },
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "first_name": {
                    "type": "string",
                    "nullable": true
                  },
                  "last_name": {
                    "type": "string",
                    "nullable": true
                  },
                  "username": {
                    "type": "string",
                    "nullable": true
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string",
                    "nullable": true
                  },
                  "role": {
                    "type": "string",
                    "example": "buyer"
                  },
                  "account_status": {
                    "type": "string",
                    "example": "verified"
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": ["email", "code"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "VerifyEmailResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Email verified successfully."
          },
          "data": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "account_status": {
                "type": "string",
                "example": "verified"
              }
            }
          }
        }
      },
      "ResendVerificationEmailRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          }
        }
      },
      "ResendVerificationEmailResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Verification email resent successfully."
          },
          "data": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["email", "code", "password", "confirm_password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "NewPassword123"
          },
          "confirm_password": {
            "type": "string",
            "format": "password",
            "example": "NewPassword123"
          }
        }
      },
      "CreateProductCategoryRequest": {
        "type": "object",
        "required": ["name", "description", "deduction_percentage"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Electronics"
          },
          "description": {
            "type": "string",
            "example": "Phones, gadgets, and accessories"
          },
          "deduction_percentage": {
            "type": "number",
            "example": 12.5
          }
        }
      },
      "CreateProductBrandRequest": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Apple"
          },
          "description": {
            "type": "string",
            "example": "Consumer electronics brand"
          }
        }
      },
      "UpdateProductCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Electronics"
          },
          "description": {
            "type": "string",
            "example": "Updated category description"
          },
          "deduction_percentage": {
            "type": "number",
            "example": 15
          }
        }
      },
      "UpdateProductBrandRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Apple"
          },
          "description": {
            "type": "string",
            "example": "Updated brand description"
          }
        }
      },
      "BuyerRegisterRequest": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "username",
          "email",
          "password",
          "phone",
          "password_confirmation"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "username": {
            "type": "string",
            "example": "john.doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123"
          },
          "phone": {
            "type": "string",
            "example": "+2348012345678"
          },
          "password_confirmation": {
            "type": "string",
            "format": "password",
            "example": "Password123"
          }
        }
      },
      "BuyerRegisterResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Buyer registered successfully."
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "example": "buyer"
              },
              "account_status": {
                "type": "string",
                "example": "not_verified"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "SellerRegisterRequest": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "username",
          "email",
          "phone_number",
          "password",
          "confirm_password",
          "account_type"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Jane"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "username": {
            "type": "string",
            "example": "jane.doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane@example.com"
          },
          "phone_number": {
            "type": "string",
            "example": "+2348012345678"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123"
          },
          "confirm_password": {
            "type": "string",
            "format": "password",
            "example": "Password123"
          },
          "account_type": {
            "type": "string",
            "enum": ["individual", "business"],
            "example": "individual"
          }
        }
      },
      "SellerRegisterResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Seller registered successfully."
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone_number": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "example": "seller"
              },
              "account_status": {
                "type": "string",
                "example": "not_verified"
              },
              "account_type": {
                "type": "string",
                "example": "individual"
              },
              "kyc_status": {
                "type": "string",
                "example": "not_started"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "UploadProductRequest": {
        "type": "object",
        "required": [
          "category_id",
          "name",
          "description",
          "price",
          "quantity",
          "currency",
          "condition",
          "weight_kg",
          "images"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "brand_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Wireless Headset"
          },
          "description": {
            "type": "string",
            "example": "Noise-cancelling wireless headset with long battery life."
          },
          "sku": {
            "type": "string",
            "example": "HEADSET-001"
          },
          "price": {
            "type": "number",
            "example": 85000
          },
          "quantity": {
            "type": "integer",
            "example": 10
          },
          "currency": {
            "type": "string",
            "example": "NGN"
          },
          "condition": {
            "type": "string",
            "example": "new"
          },
          "weight_kg": {
            "type": "number",
            "example": 0.4
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file_name", "mime_type", "file_base64"],
              "properties": {
                "file_name": {
                  "type": "string",
                  "example": "front.jpg"
                },
                "mime_type": {
                  "type": "string",
                  "enum": ["image/jpeg", "image/png", "image/webp"]
                },
                "file_base64": {
                  "type": "string",
                  "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQ..."
                }
              }
            }
          }
        }
      },
      "SaveSellerKycDraftRequest": {
        "type": "object",
        "required": ["account_type"],
        "properties": {
          "account_type": {
            "type": "string",
            "enum": ["individual", "business"]
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone_number": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "Nigeria"
          },
          "bank_name": {
            "type": "string"
          },
          "bank_account_number": {
            "type": "string",
            "example": "0123456789"
          },
          "bank_account_name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string"
          },
          "id_type": {
            "type": "string",
            "enum": [
              "national_id",
              "international_passport",
              "drivers_license",
              "voters_card"
            ]
          },
          "id_number": {
            "type": "string"
          },
          "business_name": {
            "type": "string"
          },
          "registration_number": {
            "type": "string"
          },
          "registered_business_address": {
            "type": "string"
          },
          "representative_first_name": {
            "type": "string"
          },
          "representative_last_name": {
            "type": "string"
          },
          "representative_role": {
            "type": "string"
          }
        }
      },
      "UploadSellerKycDocumentRequest": {
        "type": "object",
        "required": ["document_type", "file_name", "mime_type", "file_base64"],
        "properties": {
          "document_type": {
            "type": "string",
            "enum": [
              "proof_of_address",
              "id_document",
              "selfie",
              "cac_certificate"
            ]
          },
          "file_name": {
            "type": "string",
            "example": "utility-bill.jpg"
          },
          "mime_type": {
            "type": "string",
            "enum": ["image/jpeg", "image/png", "application/pdf"]
          },
          "file_base64": {
            "type": "string",
            "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQ..."
          }
        }
      },
      "SubmitSellerKycRequest": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ApproveProductPendingReviewRequest": {
        "type": "object",
        "properties": {
          "review_note": {
            "type": "string",
            "example": "Approved for listing."
          }
        }
      },
      "ApproveSellerKycRequest": {
        "type": "object",
        "properties": {
          "review_note": {
            "type": "string",
            "example": "All required seller KYC documents were valid."
          }
        }
      },
      "RejectProductPendingReviewRequest": {
        "type": "object",
        "required": ["review_note"],
        "properties": {
          "review_note": {
            "type": "string",
            "example": "Product images are too blurry."
          }
        }
      }
    }
  }
}
